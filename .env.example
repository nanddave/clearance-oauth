# Copy to .env.local and fill in. Never commit real values.
# Real agents run only when this is set; otherwise stub agents run.
ANTHROPIC_API_KEY=
# Optional: Composio toolkit lookup (managed or bring-your-own).
COMPOSIO_API_KEY=
# Optional locally, required on Vercel: Upstash Redis REST (Vercel integration sets KV_REST_API_URL/TOKEN instead).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Daily cap on model and search spend, in USD.
DAILY_BUDGET_USD=10
